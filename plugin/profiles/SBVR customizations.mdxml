			<packagedElement xmi:type='uml:Package' xmi:id='_17_0_5_1_8f90291_1409718925797_763625_5510' name='Integration validation'>
				<ownedRule xmi:type='uml:Constraint' xmi:id='_17_0_5_1_8f90291_1409718925797_912335_5515' name='Source check'>
					<constrainedElement xmi:idref='_17_0_5_1_8f90291_1409718925781_687287_5508'/>
					<specification xmi:type='uml:OpaqueExpression' xmi:id='_17_0_5_1_8f90291_1409718925797_352772_5520'>
						<body>self.sourceName.oclIsUndefined() or
(self.sourceName = self.client-&gt;any(true).name)</body>
						<language>OCL2.0</language>
					</specification>
				</ownedRule>
				<ownedRule xmi:type='uml:Constraint' xmi:id='_17_0_5_1_8f90291_1409718925797_944834_5516' name='Target check'>
					<constrainedElement xmi:idref='_17_0_5_1_8f90291_1409718925781_687287_5508'/>
					<specification xmi:type='uml:OpaqueExpression' xmi:id='_17_0_5_1_8f90291_1409718925797_91320_5522'>
						<body>self.targetName.oclIsUndefined() or
(self.targetName = self.supplier-&gt;any(true).name)</body>
						<language>OCL2.0</language>
					</specification>
				</ownedRule>
				<ownedRule xmi:type='uml:Constraint' xmi:id='_18_0_1_8f90291_1420993949909_991632_6141' name='Partial integration accept'>
					<constrainedElement xmi:idref='_17_0_5_1_8f90291_1409718925781_687287_5508'/>
					<specification xmi:type='uml:OpaqueExpression' xmi:id='_18_0_1_8f90291_1420993949910_455552_6142'>
						<body>self.integrationType.oclIsUndefined() implies (self.client-&gt;any(true).name = self.supplier-&gt;any(true).name)</body>
						<language>OCL2.0</language>
					</specification>
				</ownedRule>
				<ownedRule xmi:type='uml:Constraint' xmi:id='_18_0_1_8f90291_1420993980709_283550_6150' name='Full or partial integration accept'>
					<constrainedElement xmi:idref='_17_0_5_1_8f90291_1409718925781_687287_5508'/>
					<specification xmi:type='uml:OpaqueExpression' xmi:id='_18_0_1_8f90291_1420993980712_417327_6151'>
						<body>self.integrationType.oclIsUndefined() implies (self.client-&gt;any(true).name &lt;&gt; self.supplier-&gt;any(true).name)</body>
						<language>OCL2.0</language>
					</specification>
				</ownedRule>
			</packagedElement>
